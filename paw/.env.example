# QwenPaw Console login is mandatory when binding beyond localhost.
QWENPAW_BIND_ADDRESS=127.0.0.1
QWENPAW_AUTH_USERNAME=admin
QWENPAW_AUTH_PASSWORD=replace-with-a-long-random-password

# Furniture platform service-account access.
FURNITURE_API_URL=https://furniture-zk.zeabur.app
FURNITURE_API_TOKEN=replace-with-dedicated-user-token
FURNITURE_API_TIMEOUT=30

# Configure one model provider. Do not commit the real key.
DASHSCOPE_API_KEY=
