# Copy to .env for Docker Compose. Never commit real values.
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost
PUBLIC_WEB_URL=http://localhost

DB_NAME=furniture_app
DB_USER=furniture_app
DB_PASSWORD=replace-with-a-long-random-password

# Set only for first-run bootstrap. Remove after the account exists.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Enable these only when HTTPS terminates at a trusted reverse proxy.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0

FRONTEND_PORT=80
